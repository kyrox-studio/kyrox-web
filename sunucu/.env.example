# sunucu/.env olarak kopyalayın ve değerleri doldurun. .env repoya girmez.
# Rastgele değer üretmek için: openssl rand -base64 48

# Sitenin adresi (yerelde http://localhost:8090, sunucuda https://kyrox.studio)
WP_HOME=http://localhost:8090
# WordPress'in 127.0.0.1 üzerinde dinlediği port
WP_PORT=8090

WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=

WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=

# İş fişi formunun e-postası (SMTP). Boş bırakılırsa talepler yalnız panelde
# (Gelen talepler) saklanır. kur.sh bunları sorar; şifreyi orada siz girersiniz.
# Şifre tek tırnak içinde yazılır; şifrede tek tırnak olamaz.
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=''
SMTP_FROM=
